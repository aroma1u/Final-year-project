# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
*.log

# Model Checkpoints & Large Tensor Dumps (>10MB / >50MB GitHub limits)
*.pth
*.pt
*.bin
*.onnx
*.h5
*.pkl

# Allow scripts and docs in checkpoints/features
!checkpoints/.gitkeep
!features/README.md
!features/extract_features.py
!features/gemini/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
